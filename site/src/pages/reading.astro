---
import Base from '../layouts/Base.astro';
---

<Base title="The reading">
  <header class="masthead">
    <p class="kicker">फल · the reading</p>
    <h1>Phalita</h1>
    <p class="sub">A reading of the birth chart, from Phaladīpikā verse by verse.</p>
  </header>

  <form class="form" id="birth-form">
    <label><span>date</span><input type="date" name="date" value="1990-08-15" required /></label>
    <label><span>time</span><input type="time" name="time" value="06:45" required /></label>
    <label><span>latitude</span><input type="number" name="lat" step="0.0001" value="26.1844" required /></label>
    <label><span>longitude</span><input type="number" name="lon" step="0.0001" value="91.7458" required /></label>
    <label><span>tz offset</span><input type="number" name="tz" step="0.5" value="5.5" required /></label>
    <button type="submit">Read the chart</button>
  </form>

  <div id="reading"></div>

  <script>
    import '../scripts/reading';
  </script>
</Base>
