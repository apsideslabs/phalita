---
import '../styles/app.css';
import '../styles/more.css';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Phalita</title>
    <meta
      name="description"
      content="A reading of the birth chart, drawn from Phaladīpikā verse by verse."
    />
  </head>
  <body>
    <Nav />
    <main class="page">
      <slot />
    </main>
  </body>
</html>
