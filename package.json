{
  "name": "phalita",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "PHALITA — a reading of the birth chart from Phaladīpikā, verse by verse.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:corpus": "node scripts/run-check-phala.mjs",
    "bundle": "esbuild web/src/entry.ts --bundle --format=iife --minify --target=es2019 --tsconfig=tsconfig.json --outfile=web/js/engine.js",
    "build": "npm run typecheck && npm run bundle"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.24.2",
    "typescript": "5.9.3"
  }
}
